# Google Sheets Monitor Bot — Configuration
# Copy this file to .env and fill in your values

# ─── Google Sheets ────────────────────────────────────────────────────────────
# Get this from the URL: https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=your_sheet_id_here

# Local Development: Path to your downloaded Google Service Account JSON key file
GOOGLE_SERVICE_ACCOUNT_KEY=./service-account.json

# Cloud/Production: Paste the entire content of service-account.json as a string here
GOOGLE_SERVICE_ACCOUNT_JSON=

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Main channel for booking change alert notifications
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Dedicated private DM / chat ID for new user registration requests & admin approvals
TELEGRAM_ADMIN_CHAT_ID=your_private_admin_chat_id_here

# Channel for 10-day customer check-in/check-out reports
TELEGRAM_REPORT_CHAT_ID=your_report_channel_id_here

# Channel for 30-day payment reminders
TELEGRAM_REMINDER_CHANNEL_ID=your_reminder_channel_id_here

# Channel for Housekeeping room list reports (optional — auto-report disabled if not set)
TELEGRAM_HOUSEKEEPING_CHAT_ID=your_housekeeping_channel_id_here

# ─── Scheduler ────────────────────────────────────────────────────────────────
# Cron expression: "0 * * * *" = every hour on the dot
# To test: use "*/1 * * * *" for every minute
CHECK_INTERVAL_CRON=0 * * * *

# ─── Dashboard ────────────────────────────────────────────────────────────────
DASHBOARD_PORT=3000

# ─── MongoDB (Optional) ───────────────────────────────────────────────────────
# Required for production persistence on platforms like Render (ephemeral disks)
MONGODB_URI=mongodb+srv://...

# ─── Alerting (Optional) ──────────────────────────────────────────────────────
# Snooze duplicate Telegram error notifications (in hours). Default is 6 hours.
ERROR_ALERT_SNOOZE_HOURS=6

# ─── Environment & Mode ───────────────────────────────────────────────────────
# Set to 'development' to suppress sending TG notifications while developing locally.
# Set to 'production' on server (Render sets NODE_ENV=production automatically).
NODE_ENV=development

# Optional Telegram suppression overrides:
# DISABLE_TELEGRAM=true        # Force disable TG notifications in all environments
# ENABLE_TELEGRAM_IN_DEV=true # Force enable TG notifications even in development mode


